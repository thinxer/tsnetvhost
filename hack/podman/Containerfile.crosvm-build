FROM docker.io/library/ubuntu:24.04
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
    build-essential ca-certificates curl git pkg-config libcap-dev libssl-dev \
    clang libclang-dev cmake meson ninja-build python3 protobuf-compiler \
    libdbus-1-dev libglib2.0-dev \
    && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -fsSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain 1.88.0
ENV PATH=/root/.cargo/bin:$PATH
WORKDIR /workspace
